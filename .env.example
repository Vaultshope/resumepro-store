# Required: BscScan API key (free at https://bscscan.com/apis)
# Free tier: 100,000 calls/day — more than enough
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Required: Resend API key (free at https://resend.com)
# Free tier: 100 emails/day
RESEND_API_KEY=your_resend_api_key_here

# Required: Your USDT (BEP-20) wallet address for receiving payments
WALLET_ADDRESS=0x56da8226d5a0e833e91ca4b3614be0b4e5b34b6b

# Required: Email that shows as the sender (must be verified in Resend)
FROM_EMAIL=thinkedover@gmail.com

# Optional: The base URL of your site (used in email links)
# Set this in Vercel environment variables (auto-provided for production)
# SITE_URL=https://your-project.vercel.app